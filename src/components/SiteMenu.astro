---
import ContactLinks from "./ContactLinks.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const pages = [
  { label: "Home", href: `${basePath}/` },
  { label: "About", href: `${basePath}/about/` },
  { label: "Journey", href: `${basePath}/journal/` },
  { label: "Projects & Homelab", href: `${basePath}/projects/` },
];
---

<button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" hidden>
  <span>Menu</span>
  <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
</button>
<noscript>
  <nav class="fallback-nav" aria-label="Main navigation">
    {pages.map(({ label, href }) => <a href={href}>{label}</a>)}
  </nav>
</noscript>

<dialog id="site-menu" class="menu-drawer" aria-labelledby="menu-title">
  <div class="drawer-content">
    <div class="drawer-heading">
      <h2 id="menu-title">Explore</h2>
      <button class="menu-close" type="button" autofocus>
        <span>Close</span><span aria-hidden="true">×</span>
      </button>
    </div>
    <nav class="drawer-nav" aria-label="Main navigation">
      <ul>
        {pages.map(({ label, href }) => (
          <li><a href={href} aria-current={currentPath === href.replace(/\/$/, "") ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="drawer-contact">
      <p class="contact-heading">Let's connect</p>
      <ContactLinks />
    </div>
  </div>
</dialog>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const drawer = document.querySelector<HTMLDialogElement>("#site-menu");
  const close = drawer?.querySelector<HTMLButtonElement>(".menu-close");

  if (toggle && drawer && close) {
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      drawer.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("menu-open");
    });
    close.addEventListener("click", () => drawer.close());
    drawer.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("menu-open");
      toggle.focus({ preventScroll: true });
    });
    drawer.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        drawer.close();
      } else if (event.target === drawer) {
        const bounds = drawer.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) drawer.close();
      }
    });
  }
</script>

<style>
  button { font: inherit; cursor: pointer; }
  .menu-toggle {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: .85rem;
    min-height: 48px;
    padding: .65rem 1rem;
    color: var(--text);
    background: #081220ed;
    border: 1px solid var(--border);
    border-radius: 3px;
    font-size: .8rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .menu-toggle[hidden] { display: none; }
  .hamburger { display: grid; gap: 5px; width: 22px; }
  .hamburger span { height: 1px; background: currentColor; }
  .menu-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 30rem);
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    overscroll-behavior: contain;
  }
  .menu-drawer[open] { animation: drawer-in .25s ease-out; }
  .menu-drawer::backdrop { background: #020811b3; }
  .drawer-content {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 2rem clamp(1.25rem, 5vw, 3rem);
  }
  .drawer-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  #menu-title, .contact-heading {
    margin: 0;
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    min-height: 44px;
    padding: .5rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .1em;
  }
  .menu-close span:last-child { font-size: 1.75rem; line-height: 1; }
  .drawer-nav { padding: 2.5rem 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  .drawer-nav a {
    display: block;
    padding: .6rem 0;
    color: var(--text);
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .drawer-nav a[aria-current="page"] { color: var(--accent); }
  .drawer-nav a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: .3em; }
  .drawer-contact { margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center; }
  .contact-heading { margin-bottom: 1rem; }
  :is(button, a):focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .fallback-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; padding: 1rem; }
  @keyframes drawer-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @media (max-width: 600px) { .menu-toggle { top: 1rem; right: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .menu-drawer[open] { animation: none; } }
</style>
