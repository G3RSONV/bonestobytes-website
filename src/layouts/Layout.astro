---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Bones to Bytes - Clinical Informatics Journey" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta 
      name="description" 
      content={description} 
    />
  </head>

  <body>
    <header>
      <nav>
        <a class="nav-brand" href="/">
            Bones to Bytes
        </a>

        <div class="nav-links">
        <a href="/projects">Projects</a>
        <a href="/journal">Journal</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Bones to Bytes
      </p>
    </footer>
  </body>
</html>