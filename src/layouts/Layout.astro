---
import "../styles/global.css";
import SiteMenu from "../components/SiteMenu.astro";

interface Props {
  title: string;
  description?: string;
  homepage?: boolean;
}

const {
  title,
  description = "Bones to Bytes - Healthcare • Data • Technology",
  homepage = false,
} = Astro.props;

---

<!doctype html>
<html lang="en" class={homepage ? "homepage" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>

    <SiteMenu />

    <main>
      <slot />
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Bones to Bytes
      </p>
    </footer>

  </body>
</html>
