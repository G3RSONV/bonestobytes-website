---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Bones to Bytes - Healthcare • Data • Technology",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />
  </head>

  <body>

    <header>
      <nav aria-label="Main navigation">

        <a class="nav-brand" href="/">
          Bones to Bytes
        </a>

        <div class="nav-links">

          <a
            href="/projects"
            class={currentPath.startsWith("/projects") ? "active" : ""}
          >
            Projects
          </a>

          <a
            href="/journal"
            class={currentPath.startsWith("/journal") ? "active" : ""}
          >
            Journey
          </a>

        </div>

      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        © {new Date().getFullYear()} Bones to Bytes
      </p>
    </footer>

  </body>
</html>