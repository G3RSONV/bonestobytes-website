---
import Layout from "../layouts/Layout.astro";

const skills = [
  "Data analytics",
  "Data Visualization",
  "Service Management",
  "Linux",
  "Homelab"
];
---

<Layout title="Bones to Bytes | Healthcare IT">

<section class="hero">

  <div class="hero-content">

    <p class="hero-tag">
      Healthcare • Data • Technology
    </p>

    <h1>
      Bones to Bytes
    </h1>

    <h2>
      From Orthopedic Trauma Surgery to Healthcare Informatics
    </h2>

    <p>
      This portfolio showcases the projects, lessons learned, and practical experience I'm building as I transition into Clinical Informatics and Healthcare IT. Every project is an opportunity to strengthen my technical skills while applying them to real-world healthcare challenges.
    </p>

    <h3>Current Focus</h3>

    <div class="skills">
      {skills.map((skill) => (
        <span class="skill">{skill}</span>
      ))}
    </div>

  </div>

  <div class="hero-image">
    <img
      src={`${import.meta.env.BASE_URL}/images/hero.png`}
      alt="Bones to Bytes hero illustration"
    />
  </div>

</section>

</Layout>