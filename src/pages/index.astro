---
import Layout from "../layouts/Layout.astro";

const skills = [
  "SQL",
  "Tableau",
  "ITIL v4",
  "Homelab Engineering",
  "Healthcare Data Analytics",
];
---

<Layout title="Bones to Bytes | Clinical Informatics">

<section>
  <h1>Bones to Bytes</h1>

  <h2>
    From Orthopedic Trauma Surgery to Clinical Informatics
  </h2>

  <p>
    I am building the bridge between healthcare,
    data, and technology.
  </p>

  <p>
    This site documents my journey developing skills
    in healthcare analytics, IT operations, and
    clinical informatics.
  </p>

  <h3>Currently Building Skills In</h3>

  <ul>
    {skills.map(skill => (
      <li>{skill}</li>
    ))}
  </ul>
</section>

</Layout>