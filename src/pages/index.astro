---
import Layout from "../layouts/Layout.astro";

const skills = [
  "SQL",
  "Tableau",
  "ITIL v4",
  "Homelab Engineering",
  "Healthcare Data Analytics",
];
---

<Layout title="Bones to Bytes | Clinical Informatics">

<section class="hero">

  <p>
    Healthcare + Technology
  </p>

  <h1>
    Bones to Bytes
  </h1>

  <h2>
    From Orthopedic Trauma Surgery to Clinical Informatics
  </h2>

  <p>
    I am building the bridge between clinical expertise,
    healthcare data, and information technology.
  </p>

  <p>
    This portfolio documents my journey developing skills
    in SQL, Tableau, IT service management, and hands-on
    infrastructure while preparing for a career in
    Clinical Informatics.
  </p>

  <h3>
    Current Focus
  </h3>

  <ul>
    {skills.map(skill => (
      <li>{skill}</li>
    ))}
  </ul>

</section>

</Layout>