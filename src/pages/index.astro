---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Gerson Valladares | Bones to Bytes"
  description="Gerson Valladares — Orthopaedic Surgery, Healthcare IT, and Linux."
  homepage
>
  <section id="intro" class="panel hero" aria-labelledby="intro-title">
    <div class="panel-content hero-content">
      <h1 id="intro-title">Gerson Valladares</h1>
      <p class="hero-tagline">
        <span>Orthopaedic Surgery</span>
        <span class="separator" aria-hidden="true">·</span>
        <span>Healthcare IT</span>
        <span class="separator" aria-hidden="true">·</span>
        <span>Linux</span>
      </p>
    </div>
    <a class="scroll-cue" href="#about">
      <span>Scroll to explore</span>
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section id="about" class="panel panel-about" aria-labelledby="about-title">
    <div class="panel-content">
      <p class="section-label">01 / About</p>
      <h2 id="about-title">From bones<br />to bytes.</h2>
      <p class="section-description">
        I'm Gerson, a former orthopaedic trauma surgeon connecting clinical
        experience with healthcare data, information systems, and technology.
      </p>
      <a class="panel-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="journey" class="panel panel-journey" aria-labelledby="journey-title">
    <div class="panel-content">
      <p class="section-label">02 / Journey</p>
      <h2 id="journey-title">Learning along<br />the way.</h2>
      <p class="section-description">
        Notes on my transition into Clinical Informatics and Healthcare IT,
        with room for personal experiences, reflections, and life beyond work.
      </p>
      <a class="panel-link" href="/journal/">Read the journey <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="projects" class="panel panel-projects" aria-labelledby="projects-title">
    <div class="panel-content">
      <p class="section-label">03 / Projects &amp; Homelab</p>
      <h2 id="projects-title">Projects &amp;<br />homelab.</h2>
      <p class="section-description">
        Exploring healthcare data with SQL, alongside hands-on learning in Linux,
        virtualization, networking, containers, and homelab infrastructure.
      </p>
      <a class="panel-link" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="panel panel-contact" aria-labelledby="contact-title">
    <div class="panel-content">
      <p class="section-label">04 / Contact</p>
      <h2 id="contact-title">Let's connect.</h2>
      <p class="section-description">
        Healthcare, technology, or a shared interest in Linux.
        I'd be glad to connect.
      </p>
      <div class="contact-links">
        <a class="panel-link" href="https://www.linkedin.com/in/fracturefixed/">LinkedIn</a>
        <a class="panel-link" href="https://github.com/G3RSONV">GitHub</a>
        <a class="panel-link" href="mailto:g3rsonv@proton.me">Email</a>
      </div>
      <a class="back-to-top" href="#intro">Back to top ↑</a>
    </div>
  </section>

</Layout>

<style>
  :global(html.homepage) {
    scroll-snap-type: y proximity;
  }

  :global(.homepage main) {
    max-width: none;
    padding: 0;
  }

  .panel {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 8rem 1.5rem;
    text-align: center;
    scroll-snap-align: start;
    background: #081220;
  }

  .hero {
    background: radial-gradient(ellipse at 50% 100%, #102b42, #081220 65%);
  }

  .panel-projects {
    background: #172d42;
  }

  .panel-journey {
    background: #112336;
  }

  .panel-contact {
    background: #1d374d;
  }

  .panel-about {
    background: #0c1a2a;
  }

  .panel-content {
    width: 100%;
    max-width: 48rem;
  }

  .section-label {
    margin: 0 0 1.5rem;
    color: var(--accent);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.03em;
    text-wrap: balance;
  }

  .section-description {
    max-width: 30rem;
    margin: 1.5rem auto 2rem;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.8;
  }

  .panel-link {
    display: inline-block;
    padding: .5rem;
    font-weight: 600;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem 1.5rem;
  }

  .panel-link span {
    display: inline-block;
    margin-left: .35rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: .25rem;
    padding: .5rem;
    color: var(--muted);
    font-size: .7rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .scroll-cue span:last-child {
    color: var(--accent);
    font-size: 1.25rem;
  }

  .back-to-top {
    display: block;
    width: fit-content;
    margin: 3rem auto 0;
    padding: .5rem;
    color: var(--muted);
    font-size: .85rem;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
    border-radius: 2px;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .panel:not(.hero) .panel-content {
        animation: enter-panel linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes enter-panel {
    from { opacity: .3; transform: translateY(1.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.homepage) {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }
</style>
