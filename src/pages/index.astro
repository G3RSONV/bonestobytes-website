---
import Layout from "../layouts/Layout.astro";

const skills = [
  "Data analytics",
  "Data Visualization",
  "Service Management",
  "Linux",
  "Homelab"
];
---

<Layout title="Bones to Bytes | Healthcare IT">

<section class="hero">

  <div class="hero-content">

    <p class="hero-tag">
      Healthcare • Data • Technology
    </p>

    <h1>
      Bones to Bytes
    </h1>

    <h2>
      From Orthopedic Trauma Surgery to Healthcare Informatics
    </h2>

    <p>
      Former orthopedic trauma surgeon building expertise in Clinical Informatics through healthcare data, Linux, automation, and IT.
    </p>

    <p>
      This site documents my transition into Healthcare IT through hands-on
      projects in SQL, Tableau, Linux, IT service management, and homelab
      engineering. My goal is to combine real-world clinical experience with
      technical skills to help improve healthcare systems and patient outcomes.
    </p>

    <h3>Current Focus</h3>

    <div class="skills">
      {skills.map((skill) => (
        <span class="skill">{skill}</span>
      ))}
    </div>

  </div>

  <div class="hero-image">
    <img
      src="/images/hero.png"
      alt="Bones to Bytes hero illustration"
    />
  </div>

</section>

</Layout>